<?xml version="1.0" encoding="utf-8"?>
<!-- No events and no key filtering: this service only lets the Quick button open WristMic
     from any screen (Android allows apps with an active accessibility service to do that). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/button_service_desc"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="100" />
